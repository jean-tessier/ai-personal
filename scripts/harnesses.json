{
  "claude-code": {
    "label": "Claude Code",
    "scopes": {
      "project": ".claude",
      "user": "~/.claude"
    },
    "mapping": {
      "skills": "skills/{name}",
      "tasks": "commands/{name}.md",
      "workflows": "workflows/{name}"
    }
  },
  "copilot": {
    "label": "GitHub Copilot / VS Code",
    "scopes": {
      "project": ".github"
    },
    "mapping": {
      "skills": "skills/{name}"
    }
  }
}
